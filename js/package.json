{
  "private": true,
  "name": "@ernestdefoe/ruffle",
  "version": "0.1.0",
  "description": "Play Flash (.swf) in Flarum posts, with Ruffle",
  "devDependencies": {
    "@flarum/prettier-config": "^1.0.0",
    "flarum-tsconfig": "^2.0.0",
    "flarum-webpack-config": "^3.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-coverage-report": "~1.0.0",
    "webpack": "^5.0.0",
    "webpack-cli": "^5.0.0"
  },
  "scripts": {
    "dev": "webpack --mode development --watch",
    "build": "webpack --mode production",
    "format": "prettier --write src",
    "format-check": "prettier --check src",
    "check-typings": "tsc --noEmit --project tsconfig.json",
    "check-typings-coverage": "typescript-coverage-report",
    "test": "tsc src/common/swf.ts --outDir ../.test-build --target es2020 --module es2020 --moduleResolution node && node tests/swf.test.mjs"
  },
  "prettier": "@flarum/prettier-config"
}
