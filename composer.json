{
    "name": "ernestdefoe/ruffle",
    "description": "Play Flash (.swf) in posts, with Ruffle. A sandboxed emulator, not the dead plugin — no ActiveX, no NPAPI, scripting and networking locked off by default.",
    "keywords": [
        "flarum",
        "flarum-extension",
        "flash",
        "swf",
        "ruffle",
        "emulator",
        "preservation"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Ernest Defoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "homepage": "https://github.com/ernestdefoe/ruffle",
    "support": {
        "issues": "https://github.com/ernestdefoe/ruffle/issues",
        "source": "https://github.com/ernestdefoe/ruffle"
    },
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "ErnestDefoe\\Ruffle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ErnestDefoe\\Ruffle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Ruffle",
            "category": "feature",
            "icon": {
                "name": "fas fa-bolt",
                "backgroundColor": "#d4671b",
                "color": "#fff"
            }
        },
        "flarum-cli": {
            "modules": {
                "js": true,
                "css": true,
                "locale": true
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
